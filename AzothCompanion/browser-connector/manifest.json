{
  "manifest_version": 3,
  "name": "Azoth Companion Upload Connector",
  "version": "0.1.0",
  "description": "Send this PC's prepared Azoth captures through your existing signed-in Azoth upload page.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://projectazoth.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Azoth automatic uploads"
  },
  "content_scripts": [
    {
      "matches": [
        "https://projectazoth.com/upload*"
      ],
      "js": [
        "upload-page.js"
      ]
    }
  ],
  "key": ""
}
